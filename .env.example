# Copy to .env.local for local development and restart Vite.
# Local: either keep the value below (direct call, Back CORS allows :5173)
#        or leave it empty to go through the Vite proxy in vite.config.ts.
# Netlify: do NOT set this variable. Requests use relative /api/... paths
#          and the public/_redirects proxy forwards them to the backend.
# Do not include /api/projects or any secrets; VITE_* values are public.
VITE_API_BASE_URL=http://localhost:8080
